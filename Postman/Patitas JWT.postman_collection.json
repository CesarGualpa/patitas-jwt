    {
      "name": "Registrar Adoptante Hito 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst respuesta = pm.response.json();\r\n\r\npm.test(\"Username correcto\", function () {\r\n    pm.expect(respuesta.username).to.eql(\"adoptante_pedro2\");\r\n});\r\n\r\npm.test(\"Rol USER correcto\", function () {\r\n    pm.expect(respuesta.rol).to.eql(\"USER\");\r\n});\r\n\r\npm.test(\"La API no devuelve la contraseña\", function () {\r\n    pm.expect(respuesta).to.not.have.property(\"password\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"adoptante_pedro2\",\r\n    \"password\": \"mi_clave_secreta_123\",\r\n    \"rol\": \"USER\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
