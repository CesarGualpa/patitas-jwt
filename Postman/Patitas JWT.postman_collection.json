      "name": "Login JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst respuesta = pm.response.json();\r\n\r\npm.test(\"La respuesta contiene un JWT\", function () {\r\n    pm.expect(respuesta).to.have.property(\"token\");\r\n    pm.expect(respuesta.token).to.be.a(\"string\");\r\n    pm.expect(respuesta.token.length).to.be.above(20);\r\n});\r\n\r\npm.collectionVariables.set(\r\n    \"jwt_token\",\r\n    respuesta.token\r\n);"
            ]
          }
        }
      ],
